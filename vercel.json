{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?rota=recurso" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth?rota=recurso" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?rota=servidor" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth?rota=servidor" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/oauth?rota=servidor" },
    { "source": "/oauth/register", "destination": "/api/oauth?rota=registrar" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?rota=autorizar" },
    { "source": "/oauth/token", "destination": "/api/oauth?rota=token" }
  ],
  "functions": {
    "api/mcp.js": { "maxDuration": 60 },
    "api/oauth.js": { "maxDuration": 30 }
  }
}
